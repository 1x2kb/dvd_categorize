# Ollama Configuration
OLLAMA_HOST=localhost
OLLAMA_PORT=11434

# Model to use for actor reordering
# Recommended models (in order of quality):
# - qwen2.5:14b (default, excellent instruction following)
# - llama3.1:8b (good balance of speed and quality)
# - llama3.1:70b-instruct-q4_K_M (best quality
# - mistral:7b (faster, decent quality)
# - phi3.5 (smallest, lower quality)
OLLAMA_MODEL=qwen2.5:14b

# Logging level (trace, debug, info, warn, error)
RUST_LOG=info
